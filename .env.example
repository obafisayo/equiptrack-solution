# Copy to .env.local for local development.

# EquipTrack API (separate repo: equiptrack-backend). Lead capture posts here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Neon Auth (sign-in). Server-side only: never prefix these with NEXT_PUBLIC_.
# Base URL: `neon neon-auth status --project-id cold-bar-59048810 --branch main`
NEON_AUTH_BASE_URL=https://ep-lucky-thunder-b9ov8mpa.neonauth.c-7.eu-central-1.aws.neon.tech/equiptrack/auth
# 32+ random characters, e.g. `openssl rand -base64 32`. Different value per environment.
NEON_AUTH_COOKIE_SECRET=

# Organisation branding printed on TR / waybill documents.
# Defaults to a neutral "Demo Operator". Only use a customer's name/logo
# with their written permission.
NEXT_PUBLIC_ORG_SHORT_NAME=Demo Operator
NEXT_PUBLIC_ORG_LEGAL_NAME=Demo Operator Ltd.
NEXT_PUBLIC_ORG_LOGO_URL=
NEXT_PUBLIC_ORG_ACCENT_COLOR=#131722
NEXT_PUBLIC_ORG_DEFAULT_ORIGIN=MAIN BASE
